<!-- Script du widget compteur lui-même, indépendant de script.js (aucune variable/fonction en
     commun, chacun dans sa propre portée) -->
<script>
(function(){
  const CLE_STOCKAGE = 'mapetanque_compteur_partie';

  const state = {
    target: 13,
    scoreA: 0,
    scoreB: 0,
    mene: 0,
    finished: false,
    nameA: 'Team A',
    nameB: 'Team B',
  };
  const history = [];

  // Persistance de la partie en cours (localStorage), pour survivre à une fermeture d'onglet
  // accidentelle — même mécanisme que les préférences de carte ailleurs sur le site. Ne
  // sauvegarde/restaure jamais l'historique Annuler (pas essentiel, et sérialiser une pile
  // d'états à chaque action serait plus coûteux pour un bénéfice marginal).
  function sauvegarderPartie(){
    try {
      localStorage.setItem(CLE_STOCKAGE, JSON.stringify(state));
    } catch (e) { /* stockage indisponible (navigation privée, quota...) : tant pis, pas bloquant */ }
  }

  function restaurerPartie(){
    try {
      const brut = localStorage.getItem(CLE_STOCKAGE);
      if (!brut) return;
      const sauvegarde = JSON.parse(brut);
      Object.assign(state, sauvegarde);
    } catch (e) { /* sauvegarde absente ou corrompue : on repart d'une partie neuve */ }
  }

  const el = {
    scoreA: document.getElementById('scoreA'),
    scoreB: document.getElementById('scoreB'),
    boulesA: document.getElementById('boulesA'),
    boulesB: document.getElementById('boulesB'),
    nameA: document.getElementById('nameA'),
    nameB: document.getElementById('nameB'),
    meneLabel: document.getElementById('meneLabel'),
    undoBtn: document.getElementById('undoBtn'),
    win: document.getElementById('winOverlay'),
    winnerName: document.getElementById('winnerName'),
    finalScore: document.getElementById('finalScore'),
    targetToggle: document.getElementById('targetToggle'),
  };

  function snapshot(){
    history.push(JSON.stringify(state));
    if(history.length > 60) history.shift();
    el.undoBtn.disabled = false;
  }

  function renderBoules(container, score){
    container.innerHTML = '';
    for(let i=0;i<state.target;i++){
      const d = document.createElement('div');
      d.className = 'boule' + (i < score ? ' filled' : '');
      container.appendChild(d);
    }
  }

  function render(){
    el.scoreA.textContent = state.scoreA;
    el.scoreB.textContent = state.scoreB;
    renderBoules(el.boulesA, state.scoreA);
    renderBoules(el.boulesB, state.scoreB);
    el.meneLabel.textContent = 'Runde ' + state.mene;
    el.nameA.textContent = state.nameA;
    el.nameB.textContent = state.nameB;

    [...el.targetToggle.children].forEach(btn=>{
      btn.classList.toggle('active', Number(btn.dataset.t) === state.target);
    });

    sauvegarderPartie();
  }

  function launchConfetti(colors){
    const field = document.getElementById('confettiField');
    field.innerHTML = '';
    const count = 46;
    for(let i=0;i<count;i++){
      const p = document.createElement('div');
      p.className = 'confetti-piece';
      const left = Math.random()*100;
      const delay = Math.random()*0.5;
      const duration = 2.2 + Math.random()*1.3;
      const color = colors[Math.floor(Math.random()*colors.length)];
      const rotateStart = Math.random()*360;
      p.style.left = left + '%';
      p.style.background = color;
      p.style.animationDelay = delay + 's';
      p.style.animationDuration = duration + 's';
      p.style.transform = 'rotate(' + rotateStart + 'deg)';
      field.appendChild(p);
    }
  }

  function checkWin(){
    if(state.scoreA >= state.target || state.scoreB >= state.target){
      state.finished = true;
      sauvegarderPartie(); // le dernier render() a eu lieu AVANT ce passage à finished=true
      const aWon = state.scoreA >= state.target;
      el.winnerName.textContent = (aWon ? state.nameA : state.nameB) + ' gewinnt';
      el.finalScore.textContent = state.scoreA + ' – ' + state.scoreB;
      el.win.classList.remove('win-a', 'win-b');
      el.win.classList.add(aWon ? 'win-a' : 'win-b');
      const palette = aWon
        ? ['#4c7a3d', '#f2ece0', '#c9c2b4', '#7ea968']
        : ['#b5502e', '#f2ece0', '#c9c2b4', '#d97c53'];
      launchConfetti(palette);
      el.win.classList.add('show');
    }
  }

  function addPoints(team, pts){
    if(state.finished) return;
    snapshot();
    if(team === 'a') state.scoreA = Math.min(state.scoreA + pts, state.target);
    else state.scoreB = Math.min(state.scoreB + pts, state.target);
    state.mene++;
    render();
    checkWin();
  }

  function subtractPoint(team){
    if(state.finished) return;
    snapshot();
    if(team === 'a') state.scoreA = Math.max(0, state.scoreA - 1);
    else state.scoreB = Math.max(0, state.scoreB - 1);
    render();
  }

  function undo(){
    const prev = history.pop();
    if(!prev) return;
    Object.assign(state, JSON.parse(prev));
    el.win.classList.remove('show', 'win-a', 'win-b');
    el.undoBtn.disabled = history.length === 0;
    render();
  }

  function newGame(){
    history.length = 0;
    state.scoreA = 0;
    state.scoreB = 0;
    state.mene = 0;
    state.finished = false;
    el.win.classList.remove('show', 'win-a', 'win-b');
    el.undoBtn.disabled = true;
    render();
  }

  // team tap = +1, unless a chip button was tapped
  ['teamA','teamB'].forEach(id=>{
    const teamEl = document.getElementById(id);
    const team = id === 'teamA' ? 'a' : 'b';
    teamEl.addEventListener('click', (e)=>{
      const chip = e.target.closest('.chip');
      if(chip){
        const action = chip.dataset.action;
        if(action === 'minus') subtractPoint(team);
        else addPoints(team, Number(action));
        return;
      }
      if(e.target.closest('.name')) return; // editing name, don't score
      addPoints(team, 1);
    });
  });

  document.getElementById('undoBtn').addEventListener('click', (e)=>{ e.stopPropagation(); undo(); });
  document.getElementById('resetBtn').addEventListener('click', (e)=>{ e.stopPropagation(); newGame(); });
  document.getElementById('playAgainBtn').addEventListener('click', (e)=>{ e.stopPropagation(); newGame(); });

  const renameModal = document.getElementById('renameModal');
  const inputA = document.getElementById('inputA');
  const inputB = document.getElementById('inputB');

  document.getElementById('editBtn').addEventListener('click', (e)=>{
    e.stopPropagation();
    inputA.value = state.nameA;
    inputB.value = state.nameB;
    renameModal.classList.add('show');
    setTimeout(()=> inputA.focus(), 50);
  });

  document.getElementById('cancelRename').addEventListener('click', (e)=>{
    e.stopPropagation();
    renameModal.classList.remove('show');
  });

  document.getElementById('saveRename').addEventListener('click', (e)=>{
    e.stopPropagation();
    const a = inputA.value.trim();
    const b = inputB.value.trim();
    if(a) state.nameA = a;
    if(b) state.nameB = b;
    renameModal.classList.remove('show');
    render();
  });

  [inputA, inputB, renameModal].forEach(n=>{
    n.addEventListener('click', (e)=> e.stopPropagation());
  });

  el.targetToggle.addEventListener('click', (e)=>{
    e.stopPropagation();
    const btn = e.target.closest('button');
    if(!btn) return;
    state.target = Number(btn.dataset.t);
    newGame();
  });

  restaurerPartie();
  render();
  if (state.finished) checkWin();

  // Plein écran : bascule de classe CSS plutôt que l'API plein écran native du navigateur —
  // même choix que definirModePleinEcran() dans script.js pour le reste du site, pour la même
  // raison (l'API native n'est pas fiable sur Safari iOS, une part importante des visiteurs).
  const widget = document.getElementById('compteurWidget');
  const fullscreenToggleBtn = document.getElementById('fullscreenToggleBtn');
  const ICON_MAXIMIZE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path></svg>';
  const ICON_MINIMIZE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"></path></svg>';

  function definirPleinEcran(actif) {
    widget.classList.toggle('fullscreen-active', actif);
    document.body.classList.toggle('fullscreen-lock', actif);
    fullscreenToggleBtn.innerHTML = actif ? ICON_MINIMIZE : ICON_MAXIMIZE;
    fullscreenToggleBtn.setAttribute('aria-label', actif ? 'Vollbild verlassen' : 'Vollbild');
  }

  fullscreenToggleBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    definirPleinEcran(!widget.classList.contains('fullscreen-active'));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && widget.classList.contains('fullscreen-active')) {
      definirPleinEcran(false);
    }
  });
})();
</script>

