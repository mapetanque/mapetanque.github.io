<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>[TEST] Mapetanque — Page d'accueil avec pages provinces</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<!-- ==========================================================================================
     FICHIER DE TEST — copie indépendante de la page d'accueil, PAS l'index.html du site en prod.
     Objectif : valider le rendu de la bannière + la réduction de la carte + la grille de tuiles
     provinces, avant d'envisager de reporter ces changements sur le vrai index.html.
     ========================================================================================== -->

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@700&display=swap" rel="stylesheet">

<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />

<style>
    :root {
        --green: #74C15A;
        --green-dark: #56A03D;
        --green-soft: rgba(116, 193, 90, 0.1);
        --text-dark: #333;
        --border: #e2e6de;
    }

    html, body {
        margin: 0;
        overflow-x: hidden;
    }

    body {
        font-family: Arial, sans-serif;
        color: var(--text-dark);
    }

    a { color: inherit; }

    /* ===================== Bloc supérieur avec bannière photo ===================== */
    /* Reprend .map-view / .header / .hero-headline / .controls du site, avec une image de
       fond + un voile sombre pour que le texte blanc reste lisible par-dessus. */

    .map-view {
        position: relative;
        height: 300px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        box-sizing: border-box;
        padding: 0 30px 51px;
        background-image: url('images/banniere-accueil.jpg');
        background-size: cover;
        background-position: center 55%;
    }

    .header-top-row {
        position: absolute;
        top: 18px;
        left: 30px;
        right: 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        z-index: 2;
    }

    .brand-link {
        display: flex;
        align-items: center;
        gap: 5px;
        text-decoration: none;
        flex-shrink: 0;
    }

    .brand-link .logo {
        height: 2.07em;
        width: auto;
        display: block;
        filter: drop-shadow(0 1px 3px rgba(0,0,0,0.5));
    }

    .brand {
        font-family: 'Quicksand', Arial, sans-serif;
        font-weight: 700;
        font-size: 27.6px;
        color: #fff;
        text-shadow: 0 1px 4px rgba(0,0,0,0.5);
    }

    .brand-map {
        font-weight: 700;
        color: var(--green);
    }

    .brand-tld {
        color: rgba(255,255,255,0.75);
        font-weight: 400;
    }

    #desktop-nav {
        display: flex;
        align-items: center;
        gap: 2px;
    }

    .info-nav-trigger {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        border: none;
        background: none;
        text-decoration: none;
        padding: 8px 14px;
        font-size: 14px;
        font-weight: bold;
        color: #fff;
        text-shadow: 0 1px 3px rgba(0,0,0,0.5);
        cursor: pointer;
        border-radius: 20px;
        white-space: nowrap;
        transition: background-color 0.15s ease;
    }

    .info-nav-trigger:hover {
        background: rgba(255,255,255,0.18);
    }

    #lang-switcher-inline {
        display: flex;
        align-items: center;
        gap: 2px;
        margin-left: 6px;
        padding-left: 10px;
        border-left: 1px solid rgba(255,255,255,0.35);
    }

    .lang-link {
        border: none;
        background: none;
        padding: 6px 8px;
        font-size: 12px;
        font-weight: bold;
        color: rgba(255,255,255,0.75);
        cursor: pointer;
        border-radius: 12px;
        text-shadow: 0 1px 3px rgba(0,0,0,0.5);
    }

    .lang-link.active { color: #fff; }

    .banner-credit {
        position: absolute;
        bottom: 8px;
        right: 14px;
        font-size: 10.5px;
        color: rgba(255,255,255,0.75);
        text-shadow: 0 1px 2px rgba(0,0,0,0.6);
        z-index: 2;
    }

    /* Grand titre au-dessus des contrôles de recherche */
    .hero-headline {
        text-align: center;
        font-weight: 700;
        font-size: 32px;
        color: #fff;
        margin: 0 0 4px;
        line-height: 1.25;
        text-shadow: 0 2px 8px rgba(0,0,0,0.55);
        position: relative;
        z-index: 2;
    }

    .controls {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 10px;
        margin: 14px auto 22px;
        padding: 0 15px;
        position: relative;
        z-index: 2;
    }

    #locateBtn {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        border: none;
        border-radius: 20px;
        background-color: var(--green);
        color: white;
        font-size: 16px;
        cursor: pointer;
    }

    #locateBtn:hover { background-color: var(--green-dark); }

    #locateBtn .btn-icon { width: 18px; height: 18px; flex-shrink: 0; }

    .search-form {
        position: relative;
        display: flex;
        align-items: center;
    }

    .search-form input {
        padding: 12px 16px 12px 42px;
        border: 1px solid rgba(255,255,255,0.6);
        border-radius: 24px;
        font-size: 15px;
        width: 240px;
        max-width: 60vw;
        box-sizing: border-box;
        background: rgba(255,255,255,0.95);
    }

    .search-form input:focus {
        outline: none;
        border-color: var(--green);
    }

    .search-form button {
        display: flex;
        align-items: center;
        justify-content: center;
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: none;
        padding: 0;
        color: #888;
        cursor: pointer;
    }

    .search-form button svg { width: 18px; height: 18px; }

    /* ===================== Carte réduite ===================== */
    /* Volontairement plus basse que l'ancienne version plein écran, pour laisser voir le haut
       de la grille de tuiles provinces sans avoir à scroller trop loin. */
    /* Effet "fiche" sur la carte : coins arrondis + ombre légère, cohérent avec le reste du site.
       Léger espace au-dessus (repris pour moitié sur celui qui existait entre la carte et le
       titre "Parcourir par province" ci-dessous). */
    .map-wrapper {
        margin: 25px 0 0;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 6px 24px rgba(30, 50, 20, 0.10);
    }

    #map {
        width: 100%;
        height: 470px;
    }

    /* ===================== Section Provinces ===================== */

    #provinces-section {
        background-color: #f7f9f6;
        padding: 25px 20px 30px;
    }

    .provinces-container {
        max-width: 1100px;
        margin: 0 auto;
    }

    .provinces-container h2 {
        margin: 0 0 6px;
        font-size: 26px;
        color: #333;
        text-align: center;
    }

    .provinces-subtitle {
        text-align: center;
        color: #666;
        font-size: 14.5px;
        margin: 0 0 30px;
    }

    .province-tiles-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
    }

    .province-tile {
        position: relative;
        display: block;
        text-decoration: none;
        border-radius: 14px;
        overflow: hidden;
        padding-top: 75%; /* ratio 4:3, en technique padding-bottom pour compat. large */
        background-size: cover;
        background-position: center;
        background-color: #dfe8da; /* fond de secours si l'image tarde à charger */
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        box-shadow: 0 2px 10px rgba(30, 50, 20, 0.06);
    }

    .province-tile:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(30, 50, 20, 0.14);
    }

    .province-tile-name {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        padding: 10px 12px;
        color: #fff;
        font-weight: 700;
        font-size: 14.5px;
        text-shadow: 0 1px 4px rgba(0,0,0,0.6);
    }

    /* Tuiles "photo à venir" : dégradé vert de marque, en attendant le choix des bannières */
    .province-tile.placeholder {
        background-image: linear-gradient(160deg, #8fc977 0%, #4f9a3b 100%);
    }

    .province-tile.placeholder .province-tile-caption {
        position: absolute;
        top: 10px;
        right: 10px;
        font-size: 9.5px;
        font-weight: 600;
        color: rgba(255,255,255,0.85);
        background: rgba(0,0,0,0.18);
        padding: 3px 8px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    @media (max-width: 900px) {
        .province-tiles-grid { grid-template-columns: repeat(3, 1fr); }
    }

    @media (max-width: 640px) {
        .province-tiles-grid { grid-template-columns: repeat(2, 1fr); }
        .header { padding: 14px 15px 8px; }
        .brand { font-size: 21px; }
        .hero-headline { font-size: 23px; margin: 20px 0 4px; }
        #map { height: 300px; }
    }
    /* ===================== Footer ===================== */
    /* Repris tel quel du site (mêmes classes/styles), sauf position: static au lieu de fixed —
       ici il suit le flux normal de page, en bas, plutôt que rester collé à l'écran en permanence. */
    footer {
        position: static;
        height: 44px;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        padding: 0 30px;
        background: #f5f5f5;
        color: #444;
        font-size: 14px;
        line-height: 1.6;
        border-top: 1px solid #ddd;
    }

    .footer-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: nowrap;
        flex: 1;
        min-width: 0;
        gap: 12px;
    }

    .footer-small {
        font-size: 13px;
        color: #777;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
    }

    .footer-share {
        display: flex;
        align-items: center;
        gap: 6px;
        flex: 0 0 auto;
    }

    .footer-share-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        color: #999;
        border: none;
        background: none;
        cursor: pointer;
        transition: color 0.15s ease, background-color 0.15s ease;
    }

    .footer-share-icon svg { width: 14px; height: 14px; }

    .footer-share-icon:hover {
        color: #74C15A;
        background: rgba(116, 193, 90, 0.1);
    }

    @media (max-width: 600px) {
        footer { padding: 0 15px; font-size: 13px; }
        .footer-content { justify-content: center; }
    }
</style>
</head>
