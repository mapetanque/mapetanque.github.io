<!-- Empêche script.js de charger/afficher son jeu de marqueurs par défaut (tous les terrains de
     Belgique, avec clustering) : cette page construit son propre sous-ensemble juste après. -->
<script>window.MAPETANQUE_SKIP_DEFAULT_MARKERS = true;</script>

<!-- Restreint la couche clubs (chargée par script.js, voir plus bas) à cette région — même clé
     que celle utilisée juste après pour filtrer les terrains. -->
<script>window.MAPETANQUE_STATS_GEO_KEY = 'wallonie';</script>

<!-- Script du site -->
<script src="/script.js"></script>
<!-- Cloudflare Web Analytics --><script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "bab3b6a3e47743b29ac9f42465b94da3"}'></script><!-- End Cloudflare Web Analytics -->

<!-- ===================== Comportement propre à la page région ===================== -->
<!-- Réutilise les briques de script.js (icône des terrains, contenu des popups, calcul de
     distance, etc. — voir window.MAPETANQUE_SKIP_DEFAULT_MARKERS plus haut) mais charge et
     affiche uniquement les terrains de cette région. Avec regroupement (clustering) cette
     fois, contrairement aux pages province : une région comme la Flandre approche les 1 200
     terrains, bien trop pour rester lisible sans regroupement. -->
<script>
(function () {

    // Sécurité : force Leaflet à recalculer la taille de son conteneur avant tout calcul de
    // cadrage, pour que fitBounds() s'appuie sur une carte déjà correctement dimensionnée.
    if (typeof map !== 'undefined') {
        map.invalidateSize();
    }

    let toastTimeout = null;
    function afficherToast(texte) {
        const toast = document.getElementById('mapToast');
        if (!toast) return;
        toast.textContent = texte;
        toast.classList.add('visible');
        clearTimeout(toastTimeout);
        toastTimeout = setTimeout(function () { toast.classList.remove('visible'); }, 2800);
    }

    const groupe = L.markerClusterGroup({ disableClusteringAtZoom: 16 });

    fetch('/data/terrains.geojson')
        .then(function (r) { return r.json(); })
        .then(function (data) {

            const featuresRegion = data.features.filter(function (f) {
                return f.properties.region === 'wallonie';
            });

            if (featuresRegion.length === 0) {
                afficherToast('Aucun terrain chargé pour cette région');
                return;
            }

            featuresRegion.forEach(function (feature) {
                const coords = feature.geometry.coordinates; // [lon, lat]
                const latlng = [coords[1], coords[0]];
                const layer = L.marker(latlng, { icon: terrainMarkerIcon });

                window.brancherPopupTerrain(layer, feature);

                layer.addTo(groupe);
            });

            map.addLayer(groupe);

            const bounds = L.latLngBounds(featuresRegion.map(function (f) {
                return [f.geometry.coordinates[1], f.geometry.coordinates[0]];
            }));
            map.fitBounds(bounds, { padding: [30, 30] });
        })
        .catch(function () {
            afficherToast('Impossible de charger les terrains pour le moment');
        });

    // Sélecteur de langue : script.js (non modifié) renvoie toujours vers la racine de la
    // langue choisie (/nl/, /de/) et ne traduit que les menus/boutons partagés, pas le contenu
    // spécifique à cette page. On surcharge la navigation pour aller vers la vraie page région
    // équivalente quand elle existe (repli sur la racine de la langue sinon, comme avant).
    document.querySelectorAll('.lang-link[data-lang-url]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            const cible = btn.dataset.langUrl;
            if (cible) {
                window.location.href = cible;
            }
        });
    });
})();
</script>

