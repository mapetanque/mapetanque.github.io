    <link rel="alternate" hreflang="fr" href="https://mapetanque.be/compteur.html">
    <link rel="alternate" hreflang="nl" href="https://mapetanque.be/nl/compteur.html">
    <link rel="alternate" hreflang="de" href="https://mapetanque.be/de/compteur.html">
    <link rel="alternate" hreflang="x-default" href="https://mapetanque.be/compteur.html">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@600;700&display=swap" rel="stylesheet">
    <!-- Polices propres au widget compteur (Space Grotesk pour les gros scores), en plus de
         Quicksand déjà utilisée par le reste du site -->
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />

    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/style-comment-jouer.css">
    <!-- Styles du widget compteur lui-même : volontairement séparés, palette et typographie
         propres à cet outil (voir .compteur-widget) — seule zone du site où cette identité
         visuelle distincte est utilisée. -->
    <style>

  :root{
    --bg: #1c1b17;
    --bg-soft: #26241e;
    --line: #3a372f;
    --sand: #f2ece0;
    --sand-dim: #a89e8c;
    --green: #4c7a3d;
    --green-deep: #375a2c;
    --terracotta: #b5502e;
    --terracotta-deep: #8a3b21;
    --boule: #c9c2b4;
  }

  *{ box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

  /* Le compteur est un widget autonome intégré dans la page normale du site (pas le document
     entier comme dans un premier prototype) : sa palette sombre/dédiée (vert+terracotta,
     Quicksand+Space Grotesk) reste entièrement confinée à l'intérieur de .compteur-widget,
     comportement volontairement différent du thème clair du reste du site. Par défaut, hauteur
     bornée façon "carte" ; en plein écran (.fullscreen-active, bouton dans la barre du haut),
     passe en position fixe pour occuper tout le viewport — même mécanisme que le mode plein
     écran de la carte ailleurs sur le site (voir definirModePleinEcran dans script.js). */
  .compteur-widget{
    position: relative;
    height: min(640px, 80vh);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(0,0,0,0.25);

    background: var(--bg);
    font-family: 'Quicksand', sans-serif;
    color: var(--sand);
    touch-action: manipulation;
    user-select: none;
    -webkit-user-select: none;
  }

  .compteur-widget.fullscreen-active{
    position: fixed;
    inset: 0;
    height: 100vh;
    height: 100dvh;
    border-radius: 0;
    z-index: 1060;
  }

  /* Empêche la page de scroller derrière le widget tant que le plein écran est actif */
  body.fullscreen-lock {
    overflow: hidden;
  }

  .app{
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .fullscreen-toggle-btn{
    background: none;
    border: none;
    color: var(--sand-dim);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    margin-left: 8px;
  }
  .fullscreen-toggle-btn svg{ width: 18px; height: 18px; }
  .fullscreen-toggle-btn:hover{ color: var(--sand); }

  /* top bar */
  .topbar{
    display:flex;
    align-items:center;
    justify-content: space-between;
    padding: max(10px, env(safe-area-inset-top)) 14px 8px;
    background: var(--bg);
    font-size: 12px;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--sand-dim);
    flex: 0 0 auto;
    z-index: 5;
  }
  .topbar button{
    background:none; border:none; color: var(--sand-dim);
    font-family: inherit; font-size: 12px; letter-spacing:.06em; text-transform:uppercase;
    padding: 6px 8px; cursor:pointer;
  }
  .target-toggle{ display:flex; gap:4px; background: var(--bg-soft); border-radius: 20px; padding:3px; }
  .target-toggle button{
    padding: 5px 12px; border-radius: 16px; color: var(--sand-dim);
  }
  .target-toggle button.active{ background: var(--sand); color: var(--bg); font-weight:700; }
  .mene-count{ font-variant-numeric: tabular-nums; }

  /* halves */
  .halves{
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  @media (orientation: landscape){
    .halves{ flex-direction: row; }
    .divider{ width:1px; height:100%; }
  }

  .team{
    flex: 1 1 0;
    display:flex;
    flex-direction: column;
    align-items:center;
    justify-content:center;
    position: relative;
    padding: 8px 16px 14px;
    min-height: 0;
    cursor: pointer;
    transition: filter .15s ease;
  }
  .team:active{ filter: brightness(1.12); }
  .team.a{ background: var(--green); }
  .team.b{ background: var(--terracotta); }

  .divider{
    height: 1px;
    background: rgba(0,0,0,.35);
    flex: 0 0 auto;
  }

  .name{
    font-size: 14px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: rgba(255,255,255,.85);
    padding: 4px 10px;
    border-radius: 8px;
    max-width: 90%;
    text-align:center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .name[contenteditable="true"]{
    background: rgba(0,0,0,.25);
    outline: none;
    white-space: normal;
  }

  .score{
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: min(28vh, 32vw);
    line-height: 1;
    color: var(--sand);
    margin: 2px 0 6px;
    font-variant-numeric: tabular-nums;
  }

  .boules{
    display:flex;
    flex-wrap: wrap;
    justify-content:center;
    gap: 4px;
    max-width: 260px;
    margin-bottom: 14px;
  }
  .boule{
    width: 9px; height: 9px; border-radius: 50%;
    background: rgba(255,255,255,.18);
    flex: 0 0 auto;
  }
  .boule.filled{ background: var(--boule); box-shadow: 0 0 0 1px rgba(0,0,0,.15) inset; }

  .controls{
    display:flex;
    align-items:center;
    flex-wrap: wrap;
    justify-content:center;
    gap: 8px;
    max-width: 260px;
  }
  .chip{
    border: 1.5px solid rgba(255,255,255,.4);
    color: var(--sand);
    background: rgba(0,0,0,.12);
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    border-radius: 999px;
    padding: 7px 13px;
    font-size: 14px;
    line-height: 1;
  }
  .chip.minus{
    border-color: rgba(255,255,255,.25);
    color: rgba(255,255,255,.7);
    font-size: 12px;
    padding: 6px 11px;
  }

  .hint{
    position:absolute;
    bottom: 8px;
    font-size: 10px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: rgba(255,255,255,.35);
  }

  /* bottom bar */
  .bottombar{
    flex: 0 0 auto;
    display:flex;
    align-items:center;
    justify-content:center;
    gap: 18px;
    padding: 10px 14px max(10px, env(safe-area-inset-bottom));
    background: var(--bg);
  }
  .bottombar button{
    background:none; border:none; color: var(--sand-dim);
    font-family: 'Quicksand', sans-serif; font-weight:600;
    font-size: 13px; letter-spacing:.04em;
    padding: 8px 10px; cursor:pointer;
    display:flex; align-items:center; gap:6px;
  }
  .bottombar button:disabled{ opacity:.35; }

  /* win overlay */
  .win{
    position:absolute; inset:0;
    background: rgba(10,9,7,.92);
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    gap: 18px;
    opacity:0; pointer-events:none;
    transition: opacity .3s ease, background .3s ease;
    z-index: 20;
    text-align:center;
    padding: 20px;
    overflow: hidden;
  }
  .win.show{ opacity:1; pointer-events:auto; }
  .win.win-a{ background: linear-gradient(180deg, #1e2e17, #14200f); }
  .win.win-b{ background: linear-gradient(180deg, #3a2015, #26140d); }
  .win .trophy-line{
    font-size: 12px; letter-spacing:.14em; text-transform:uppercase; color: var(--sand-dim);
  }
  .win .winner-name{
    font-family:'Space Grotesk', sans-serif; font-weight:700;
    font-size: 34px; color: var(--sand);
  }
  .win .final-score{
    font-family:'Space Grotesk', sans-serif; font-weight:700;
    font-size: 20px; color: var(--sand-dim);
  }
  .win button{
    margin-top: 8px;
    background: var(--sand); color: var(--bg);
    border:none; border-radius: 999px;
    font-family:'Quicksand',sans-serif; font-weight:700;
    padding: 12px 26px; font-size: 15px; cursor:pointer;
  }
  .win button.secondary{
    background: transparent; color: var(--sand);
    border: 1.5px solid rgba(255,255,255,.35);
    margin-top: 8px;
  }

  .confetti-field{
    position:absolute; inset:0;
    pointer-events:none;
    overflow:hidden;
  }
  .confetti-piece{
    position:absolute;
    top: -20px;
    width: 8px;
    height: 14px;
    opacity: .9;
    border-radius: 2px;
    animation-name: confetti-fall;
    animation-timing-function: cubic-bezier(.35,.05,.6,.95);
    animation-iteration-count: 1;
    animation-fill-mode: forwards;
  }
  @keyframes confetti-fall{
    0%{ transform: translateY(0) rotate(0deg); opacity: .95; }
    85%{ opacity: .9; }
    100%{ transform: translateY(115vh) rotate(540deg); opacity: 0; }
  }
  .modal-field{
    display:flex; flex-direction:column; gap:6px;
    width: min(280px, 80vw);
    text-align:left;
  }
  .modal-field span{
    font-size: 11px; letter-spacing:.08em; text-transform:uppercase; color: var(--sand-dim);
  }
  .modal-field input{
    font-family:'Quicksand',sans-serif; font-weight:600; font-size:17px;
    background: var(--bg-soft); color: var(--sand);
    border: 1.5px solid rgba(255,255,255,.25); border-radius: 10px;
    padding: 10px 12px; outline:none;
  }
  .modal-field input:focus{ border-color: var(--sand); }

    </style>
</head>

