    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta property="og:title" content="Compteur de points — Mapetanque.be">
    <meta property="og:description" content="Un compteur de points interactif pour suivre le score de vos parties de pétanque, sur mobile ou tablette.">
    <meta property="og:image" content="https://mapetanque.be/images/logomap.png">
    <meta property="og:url" content="https://mapetanque.be/compteur.html">
