<!-- Empêche script.js de charger/afficher son jeu de marqueurs par défaut (tous les terrains de
     Belgique, avec clustering) : cette page construit son propre sous-ensemble juste après. -->
<script>window.MAPETANQUE_SKIP_DEFAULT_MARKERS = true;</script>

<!-- Script du site -->
<script src="/script.js"></script>
<!-- Cloudflare Web Analytics --><script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "bab3b6a3e47743b29ac9f42465b94da3"}'></script><!-- End Cloudflare Web Analytics -->

<!-- ===================== Comportement propre à la page province ===================== -->
<!-- Réutilise les briques de script.js (icône des terrains, contenu des popups, calcul de
     distance, etc. — voir window.MAPETANQUE_SKIP_DEFAULT_MARKERS plus haut) mais charge et
     affiche uniquement les terrains de cette province, sans regroupement (clustering) puisque
     le sous-ensemble est déjà restreint. -->
<script>
(function () {

    // Sécurité : force Leaflet à recalculer la taille de son conteneur avant tout calcul de
    // cadrage, pour que fitBounds() s'appuie sur une carte déjà correctement dimensionnée.
    if (typeof map !== 'undefined') {
        map.invalidateSize();
    }

    function appartientALaProvince(props) {
        if (props.province) return props.province === 'namur';
        return props.region === 'namur'; // cas particulier Bruxelles (pas de province)
    }

    let toastTimeout = null;
    function afficherToast(texte) {
        const toast = document.getElementById('mapToast');
        if (!toast) return;
        toast.textContent = texte;
        toast.classList.add('visible');
        clearTimeout(toastTimeout);
        toastTimeout = setTimeout(function () { toast.classList.remove('visible'); }, 2800);
    }

    fetch('/data/terrains.geojson')
        .then(function (r) { return r.json(); })
        .then(function (data) {

            // Compteur du footer : total Belgique (comme sur la page d'accueil), pas seulement
            // cette province — script.js ne le fait plus lui-même vu MAPETANQUE_SKIP_DEFAULT_MARKERS.
            if (typeof afficherNombreTerrains === 'function') {
                afficherNombreTerrains(data.features.length);
            }

            const featuresProvince = data.features.filter(function (f) {
                return appartientALaProvince(f.properties);
            });

            if (featuresProvince.length === 0) {
                afficherToast('Aucun terrain chargé pour cette province');
                return;
            }

            const groupe = L.layerGroup();
            const layersParCommune = {};

            featuresProvince.forEach(function (feature) {
                const coords = feature.geometry.coordinates; // [lon, lat]
                const latlng = [coords[1], coords[0]];
                const layer = L.marker(latlng, { icon: terrainMarkerIcon });

                layer.bindPopup(function () {
                    return window.construireContenuPopupTerrain(feature, layer);
                });
                layer.on('popupopen', function (e) {
                    window.brancherPartagePopup(e, feature, layer);
                });

                layer.addTo(groupe);

                const commune = feature.properties.commune;
                if (commune) {
                    if (!layersParCommune[commune]) layersParCommune[commune] = [];
                    layersParCommune[commune].push(layer);
                }
            });

            groupe.addTo(map);

            const bounds = L.latLngBounds(featuresProvince.map(function (f) {
                return [f.geometry.coordinates[1], f.geometry.coordinates[0]];
            }));
            map.fitBounds(bounds, { padding: [30, 30] });

            // Liste des communes : construite depuis ce même jeu de données (garantit qu'elle
            // correspond exactement à ce qui est affiché sur la carte), triée par nombre de
            // terrains décroissant comme avant.
            const conteneurListe = document.getElementById('communeList');
            const nomsTries = Object.keys(layersParCommune).sort(function (a, b) {
                return layersParCommune[b].length - layersParCommune[a].length;
            });

            nomsTries.forEach(function (nom) {
                const item = document.createElement('div');
                item.className = 'commune-item';
                item.dataset.rechercheClef = nom.toLowerCase();

                const link = document.createElement('a');
                link.href = '#';
                const count = layersParCommune[nom].length;
                const unite = count > 1 ? 'Plätze' : 'Platz';
                const nomAffiche = window.nomCommuneAffiche(nom, 'de');
                link.innerHTML = nomAffiche + ' <span class="commune-count">(' + count + ' ' + unite + ')</span>';
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    const layersCommune = layersParCommune[nom];
                    const boundsCommune = L.latLngBounds(layersCommune.map(function (l) { return l.getLatLng(); }));
                    map.fitBounds(boundsCommune, { padding: [40, 40], maxZoom: 16 });
                    if (layersCommune.length === 1) {
                        layersCommune[0].openPopup();
                    }
                    document.getElementById('map').scrollIntoView({ behavior: 'smooth', block: 'center' });
                });

                item.appendChild(link);
                conteneurListe.appendChild(item);
            });
        })
        .catch(function () {
            afficherToast('Impossible de charger les terrains pour le moment');
        });

    document.getElementById('communeSearch').addEventListener('input', function (e) {
        const q = e.target.value.trim().toLowerCase();
        const items = document.querySelectorAll('.commune-item');
        let visibleCount = 0;
        items.forEach(function (item) {
            const match = item.dataset.rechercheClef.includes(q);
            item.style.display = match ? '' : 'none';
            if (match) visibleCount++;
        });
        document.getElementById('communeNoResult').style.display = visibleCount === 0 ? 'block' : 'none';
    });

    // Sélecteur de langue : script.js (non modifié) renvoie toujours vers la racine de la
    // langue choisie (/nl/, /de/) et ne traduit que les menus/boutons partagés, pas le contenu
    // spécifique à cette page. On surcharge la navigation pour aller vers la vraie page province
    // équivalente quand elle existe (repli sur la racine de la langue sinon, comme avant).
    document.querySelectorAll('.lang-link[data-lang-url]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            const cible = btn.dataset.langUrl;
            if (cible) {
                window.location.href = cible;
            }
        });
    });
})();
</script>

</body>
</html>
