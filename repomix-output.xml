/* Liens dans les popups de terrain (itinéraire, partager) :
   seul le texte est souligné, pas l'icône ni l'espace qui le sépare du texte */
.leaflet-popup-content a {
    text-decoration: none;
}

/* Position de la croix de fermeture fixée explicitement (plutôt que de laisser le positionnement
   par défaut de Leaflet, dont on ne maîtrise pas la géométrie interne exacte) — la barre de
   défilement ci-dessous est calée sur cette même valeur de 12px, pour que les deux soient enfin
   ancrées au même repère plutôt que de deviner chacune de son côté. */
.leaflet-popup-close-button {
    top: 10px !important;
    right: 12px !important;
}

/* Barre de défilement plus fine et arrondie sur les fiches terrain (le plafond de 320px, voir
   bindPopup dans script.js, rend le contenu défilable dès qu'il dépasse) — la barre par défaut
   du navigateur est large et carrée, peu en phase avec le reste du design du site.
   Marge droite calée sur le right:12px de la croix ci-dessus (voir commentaire), et padding-right
   ajouté pour redonner de l'air entre le texte et la barre — sans ce padding, le texte touchait
   quasiment le curseur.
   Marge du haut légèrement augmentée pour que la barre démarre un peu plus bas que la croix de
   fermeture plutôt que juste en dessous. */
.leaflet-popup-content {
    margin: 40px 12px 13px 20px;
    padding-right: 8px;
    scrollbar-width: thin; /* Firefox */
    scrollbar-color: #d6d6d6 transparent;
}

.leaflet-popup-content::-webkit-scrollbar {
    width: 4px;
}

.leaflet-popup-content::-webkit-scrollbar-track {
    background: transparent;
}

.leaflet-popup-content::-webkit-scrollbar-thumb {
    background: #d6d6d6;
    border-radius: 999px;
}

.leaflet-popup-content::-webkit-scrollbar-thumb:hover {
    background: #b8b8b8;
}

/* Certains navigateurs (Edge/Chrome sous Windows notamment) affichent encore les petites flèches
   natives en haut/bas de la barre — jamais alignées avec la croix de fermeture ni avec le reste
   du design personnalisé ci-dessus, donc autant les retirer complètement plutôt que d'essayer de
   les repositionner. */
.leaflet-popup-content::-webkit-scrollbar-button {
    display: none;
}

/* display:none posé ici, HORS media query, pour ces deux éléments : sans ça, au-delà de 1024px de
   large, aucune règle ne s'applique du tout à eux (tout leur style vit dans le
   @media (max-width: 1024px) ci-dessous) — #mobile-sheet-close, un <button> bien réel, se
   retrouvait alors affiché tel quel dans le flux normal de la page (petite croix visible en haut
   à gauche), puisque rien ne le cachait par défaut en desktop. */
#mobile-sheet-overlay,
#mobile-sheet {
    display: none;
}

/* display:none posé ici, HORS media query, même raison que ci-dessus mais pour la fenêtre
   flottante desktop cette fois : son CSS vit entièrement dans le @media (min-width: 1025px)
   plus bas, donc sans ce garde-fou elle resterait affichée par défaut sur mobile. */
#desktop-modal-overlay,
#desktop-modal {
    display: none;
}

/* Fiche terrain en plein écran sur mobile — le petit popup Leaflet reste inchangé (utile pour
   desktop), mais sur mobile son CONTENU est déplacé (pas copié : mêmes nœuds DOM, écouteurs
   d'événements déjà branchés conservés intacts) dans ce panneau séparé, en dehors de toute la
   hiérarchie de calques transformés de Leaflet. Nécessaire car .leaflet-map-pane porte son
   propre transform (translate3d), qui piège position:fixed sur tout descendant — impossible à
   contourner en CSS pur depuis l'intérieur de cette hiérarchie (vérifié). Voir
   ouvrirFicheMobileTerrain()/fermerFicheMobileTerrain() dans script.js. */
@media (max-width: 1024px) {
    #mobile-sheet-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.35);
        z-index: 1400;
    }

    #mobile-sheet-overlay.visible {
        display: block;
    }

    #mobile-sheet {
        position: fixed;
        /* Centré verticalement avec max-height plutôt qu'une hauteur fixe (top+bottom) : la
           fiche s'adapte à son contenu, ne s'étire au maximum que si le contenu est réellement
           long — même technique que #desktop-modal plus bas, pour rester cohérent et éviter de
           réinventer une deuxième logique de dimensionnement à maintenir en parallèle. */
        top: 50%;
        left: 12px;
        right: 12px;
        transform: translateY(-50%);
        max-height: calc(100vh - 24px);
        max-height: calc(100dvh - 24px);
        z-index: 1450;
        background: white;
        border-radius: 16px;
        box-shadow: 0 12px 40px rgba(0,0,0,0.25);
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
    }

    #mobile-sheet.open {
        display: block;
    }

    #mobile-sheet-close {
        position: absolute;
        top: 14px;
        right: 14px;
        width: 36px;
        height: 36px;
        border: none;
        border-radius: 50%;
        background: #f2f2f2;
        font-size: 24px;
        line-height: 36px;
        text-align: center;
        color: #333;
        z-index: 1;
    }

    #mobile-sheet-content {
        width: 100%;
        padding: 60px 16px 24px;
        box-sizing: border-box;
    }

    /* Le nœud déplacé ici (.leaflet-popup-content) garde sa marge propre au petit popup ancré
       desktop (réglée pour espacer SA barre de défilement de SA croix, voir plus haut) — sans
       ce reset, elle s'additionne au padding ci-dessus et crée un grand vide en haut. Le padding
       du conteneur suffit, seule source de marge une fois le contenu relocalisé ici. */
    #mobile-sheet-content .leaflet-popup-content {
        margin: 0 !important;
        padding: 0 !important;
    }
}

/* Fiche terrain en fenêtre flottante centrée sur desktop — même principe/même mécanisme que le
   panneau plein écran mobile ci-dessus (contenu déplacé, pas copié), juste habillé en petite
   fenêtre modale plutôt qu'en plein écran, plus adapté à un grand viewport. Remplace le popup
   Leaflet classique, qui se retrouvait coincé/rogné dans les limites de la carte. */
@media (min-width: 1025px) {
    #desktop-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.35);
        z-index: 1400;
    }

    #desktop-modal-overlay.visible {
        display: block;
    }

    #desktop-modal {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 555px; /* 483px + 15% (déjà +15% une première fois avant) */
        max-width: calc(100vw - 48px);
        max-height: 98vh; /* 85vh + 15% */
        z-index: 1450;
        background: white;
        border-radius: 12px;
        box-shadow: 0 12px 40px rgba(0,0,0,0.25);
        overflow-y: auto;
    }

    #desktop-modal.open {
        display: block;
    }

    #desktop-modal-close {
        position: absolute;
        top: 14px;
        right: 14px;
        width: 32px;
        height: 32px;
        border: none;
        border-radius: 50%;
        background: #f2f2f2;
        font-size: 20px;
        line-height: 32px;
        text-align: center;
        color: #333;
        z-index: 1;
        cursor: pointer;
    }

    #desktop-modal-content {
        width: 100%;
        padding: 48px 20px 24px;
        box-sizing: border-box;
    }

    /* Même correctif que pour #mobile-sheet-content ci-dessus : neutralise la marge propre au
       petit popup ancré desktop, héritée par le nœud déplacé ici, qui créait un grand vide en
       haut de la fenêtre en s'additionnant au padding ci-dessus. */
    #desktop-modal-content .leaflet-popup-content {
        margin: 0 !important;
        padding: 0 !important;
    }
}

.popup-link-text {
