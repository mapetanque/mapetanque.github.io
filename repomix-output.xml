    <!-- Feuille de style du site (chemin absolu : ce même fichier index.html est aussi servi
         depuis /nl/ et /de/, un chemin relatif irait chercher /nl/style.css et casserait tout) -->
    <link rel="stylesheet" href="/style.css">

    <!-- Bannière photo + grille "Parcourir par province" : ajouts additifs uniquement, aucune
