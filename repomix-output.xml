<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <title>Scoreteller — Mapetanque.be</title>
    <meta name="description" content="Een interactieve scoreteller om de stand van je petanquepartijen bij te houden, op mobiel of tablet.">
    <link rel="icon" type="image/svg+xml" href="/images/logomap.svg">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta property="og:title" content="Scoreteller — Mapetanque.be">
    <meta property="og:description" content="Een interactieve scoreteller om de stand van je petanquepartijen bij te houden, op mobiel of tablet.">
    <meta property="og:image" content="https://mapetanque.be/images/logomap.png">
    <meta property="og:url" content="https://mapetanque.be/nl/compteur.html">
