<div class="rules-content compteur-page-content">

<div class="compteur-widget" id="compteurWidget">
<div class="app">

  <div class="topbar">
    <div class="target-toggle" id="targetToggle">
      <button data-t="11">11</button>
      <button data-t="13" class="active">13</button>
    </div>
    <div class="mene-count" id="meneLabel">ronde 0</div>
    <button id="resetBtn">Nieuw spel</button>
    <button class="fullscreen-toggle-btn" id="fullscreenToggleBtn" aria-label="Volledig scherm">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path></svg>
    </button>
  </div>

  <div class="halves">
    <div class="team a" id="teamA">
      <div class="name" id="nameA" contenteditable="false">Team A</div>
      <div class="score" id="scoreA">0</div>
      <div class="boules" id="boulesA"></div>
      <div class="controls">
        <div class="chip minus" data-team="a" data-action="minus">−1</div>
        <div class="chip" data-team="a" data-action="2">+2</div>
        <div class="chip" data-team="a" data-action="3">+3</div>
      </div>
      <div class="hint">tik voor +1</div>
    </div>

    <div class="divider"></div>

    <div class="team b" id="teamB">
      <div class="name" id="nameB" contenteditable="false">Team B</div>
      <div class="score" id="scoreB">0</div>
      <div class="boules" id="boulesB"></div>
      <div class="controls">
        <div class="chip minus" data-team="b" data-action="minus">−1</div>
        <div class="chip" data-team="b" data-action="2">+2</div>
        <div class="chip" data-team="b" data-action="3">+3</div>
      </div>
      <div class="hint">tik voor +1</div>
    </div>
  </div>

  <div class="bottombar">
    <button id="undoBtn" disabled>↺ Herstel</button>
    <button id="editBtn">✎ Namen wijzigen</button>
  </div>

  <div class="win" id="winOverlay">
    <div class="confetti-field" id="confettiField"></div>
    <div class="trophy-line">Spel afgelopen</div>
    <div class="winner-name" id="winnerName">Team A wint</div>
    <div class="final-score" id="finalScore">13 – 7</div>
    <button id="playAgainBtn">Nieuw spel</button>
  </div>

  <div class="win" id="renameModal">
    <div class="trophy-line">Teams hernoemen</div>
    <label class="modal-field">
      <span>Team A</span>
      <input type="text" id="inputA" maxlength="20">
    </label>
    <label class="modal-field">
      <span>Team B</span>
      <input type="text" id="inputB" maxlength="20">
    </label>
    <div style="display:flex; gap:12px; margin-top:6px;">
      <button id="cancelRename" class="secondary">Annuleren</button>
      <button id="saveRename">Opslaan</button>
    </div>
  </div>

</div><!-- /.app -->
