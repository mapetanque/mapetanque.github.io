}

/* Photo du terrain dans le popup (issue d'un tag OSM image=/wikimedia_commons=/mapillary=,
   voir resoudre_photo() dans update_terrains.py) */
.popup-photo {
    display: block;
    width: 100%;
    max-height: 140px;
    object-fit: cover;
    border-radius: 4px;
    margin-bottom: 4px;
}

.popup-photo-credit {
    font-size: 11px;
    color: #999;
}

/* Iframe d'embed Mapillary (voir construireContenuPopupTerrain) : même gabarit que .popup-photo,
   mais nécessite une hauteur explicite (une iframe n'a pas de ratio intrinsèque comme une image). */
.popup-photo-iframe {
    height: 140px;
    border: none;
    /* Laisse remonter le geste de défilement vertical au panneau parent plutôt que de le
       laisser capturé par l'iframe (contenu interactif d'un autre domaine) — sans ça, un
       glissé démarré sur la photo peut bloquer le défilement du reste de la fiche sur mobile. */
    touch-action: pan-y;
}

/* Bouton "agrandir" superposé à chaque photo (voir avecBoutonAgrandir dans script.js) — même
   traitement pour une <img> classique ou l'iframe Mapillary, cette dernière ne pouvant pas être
   rendue cliquable directement (contenu d'un autre domaine). */
.popup-photo-wrap {
    position: relative;
}

/* Zone cliquable couvrant toute la photo, sans indice visuel superposé (juste le curseur qui
   change au survol) — sert aussi pour l'embed Mapillary, où on ne peut pas rendre l'iframe
   elle-même cliquable (contenu d'un autre domaine). */
.popup-photo-expand-zone {
    position: absolute;
    inset: 0;
    display: block;
    cursor: pointer;
}

/* Illustration de substitution quand un terrain n'a aucune photo, + bouton d'invitation à en
   proposer une (ouvre #add-photo-modal, voir script.js). */
.popup-photo-placeholder {
    opacity: 0.85;
    /* L'illustration doit se voir en entier (contrairement à une vraie photo, où recadrer les
       bords passe inaperçu) — "cover" la déforme/coupe fortement une fois étirée sur toute la
       largeur d'un écran mobile avec une hauteur fixe. */
    object-fit: contain;
    background: #f7f7f5;
}

.popup-photo-add-btn {
    display: block;
    width: 100%;
    background: none;
    border: 1px dashed #74C15A;
    border-radius: 4px;
